{
  // The end-to-end tests run in Node but hand functions to the page, so they see both worlds' types.
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "lib": ["ES2023", "DOM"]
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts"]
}

{
  "name": "factory-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-main.mjs",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "test": "npm run build && playwright test",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "demo": "npm run build && node scripts/demo.mjs"
  },
  "devDependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lezer/highlight": "^1.2.5",
    "@lucide/svelte": "^1.73.0",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "bits-ui": "^2.21.0",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.18",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "marked": "^18.2.0",
    "shadcn-svelte": "^1.8.1",
    "shiki": "^4.6.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  },
  "productName": "Factory",
  "description": "The portable project factory: board, pull request review, issues and code, in one desktop app.",
  "author": "RT-codes",
  "license": "Apache-2.0",
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "codes.rt.factory",
    "productName": "Factory",
    "files": [
      "dist-desktop/**",
      "dist-electron/**",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "executableName": "factory-app",
      "artifactName": "Factory-${version}-linux-${arch}.${ext}",
      "category": "Development",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Factory-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Factory-${version}-win-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "extraResources": [
      {
        "from": "../install.mjs",
        "to": "kit-installer/install.mjs"
      },
      {
        "from": "../package.json",
        "to": "kit-installer/package.json"
      },
      {
        "from": "../kit",
        "to": "kit-installer/kit",
        "filter": [
          "**/*",
          "!test/**"
        ]
      }
    ]
  }
}
